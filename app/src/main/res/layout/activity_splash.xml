<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/toolbar_dark">

    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:src="@drawable/ic_pipra_ant_mark"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="34sp"
        android:letterSpacing="0.06"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/about_tagline"
        android:textColor="@color/accent_bright"
        android:textSize="14sp" />

    <View
        android:layout_width="56dp"
        android:layout_height="2dp"
        android:layout_marginTop="24dp"
        android:background="@color/border_silver" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/about_dev_line"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
